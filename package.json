{
  "name": "call-calendar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Сервис бронирования звонков: TypeSpec, OpenAPI, Express и React",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "spec:build": "npm run build -w @call-calendar/spec",
    "api:generate": "npm run generate -w @call-calendar/spec",
    "dev:api": "npm run dev -w @call-calendar/api",
    "dev:web": "npm run dev -w @call-calendar/web",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
